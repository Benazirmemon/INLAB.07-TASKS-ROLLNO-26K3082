#include <stdio.h>
int main() {
    int a[5][2], i;
    float total = 0;

    for(i=0; i<5; i++) {
        printf("Enter quantity and price: ");
        scanf("%d%d", &a[i][0], &a[i][1]);
    }

    for(i=0; i<5; i++) {
        printf("%d %d %d\n", a[i][0], a[i][1],
               a[i][0] * a[i][1]);
        total += a[i][0] * a[i][1];
    }

    printf("Grand Total = %.2f", total);
    return 0;
}
